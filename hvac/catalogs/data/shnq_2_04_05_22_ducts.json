        "maxInclusive": true
      },
      "unit": "m²",
      "appliesTo": {
        "kind": ["ventilation_system_combination", "collecting_duct_connection"],
        "building": ["residential", "administrative", "public"],
        "element": ["rooms_from_other_group"],
        "combination": ["residential_with_administrative_or_public"],
        "fireDamper": ["required_on_connected_group_collecting_duct"]
      },
      "source": {
        "document": "ШНҚ 2.04.05-22",
        "edition": "2024-08-05 (приказ № 01/2-39)",
        "clause": "199",
        "pagePdf": 26,
        "table": null
      },
      "status": "unverified",
      "noteRu": "При объединении жилых помещений с административно-бытовыми либо общественными помещениями допускается присоединять помещения другой группы общей площадью не более 200 m², если на сборном воздуховоде присоединяемой группы установлен огнезадерживающий клапан."
    },
    {
      "key": "routing.ventilation_system.other_room_group.industrial_g_d_administrative.area.max",
      "range": {
        "min": null,
        "max": 200,
        "minInclusive": false,
        "maxInclusive": true
      },
      "unit": "m²",
      "appliesTo": {
        "kind": ["ventilation_system_combination", "collecting_duct_connection"],
        "building": ["industrial", "administrative"],
        "element": ["rooms_from_other_group"],
        "combination": ["industrial_g_or_d_with_administrative"],
        "fireCategory": ["G", "D"],
        "occupancy": ["excluding_mass_occupancy"]
      },
      "source": {
        "document": "ШНҚ 2.04.05-22",
        "edition": "2024-08-05 (приказ № 01/2-39)",
        "clause": "199",
        "pagePdf": 26,
        "table": null
      },
      "status": "unverified",
      "noteRu": "При объединении производственных помещений категорий Г или Д с административно-бытовыми помещениями допускается присоединять помещения другой группы общей площадью не более 200 m²; помещения с массовым пребыванием людей исключены."
    },
    {
      "key": "routing.ventilation_system.other_room_group.industrial_a_b_v_other_industrial_storage.area.max",
      "range": {
        "min": null,
        "max": 200,
        "minInclusive": false,
        "maxInclusive": true
      },
      "unit": "m²",
      "appliesTo": {
        "kind": ["ventilation_system_combination", "collecting_duct_connection"],
        "building": ["industrial", "warehouse"],
        "element": ["rooms_from_other_group"],
        "combination": ["industrial_a_b_v_with_other_industrial_or_storage"],
        "fireCategory": ["A", "B", "V"],
        "excludedUse": ["residential", "mass_occupancy"],
        "fireDamper": ["required_on_collecting_duct"],
        "condition": ["clause_296_requirements_apply"]
      },
      "source": {
        "document": "ШНҚ 2.04.05-22",
        "edition": "2024-08-05 (приказ № 01/2-39)",
        "clause": "199",
        "pagePdf": 26,
        "table": null
      },
      "status": "unverified",
      "noteRu": "Для указанного в п. 199 объединения производственных помещений категорий А, Б или В с иными производственными либо складскими помещениями допускается присоединять помещения другой группы общей площадью не более 200 m². Жилые помещения и помещения массового пребывания исключены; на сборном воздуховоде требуется огнезадерживающий клапан и соблюдение п. 296."
    },
    {
